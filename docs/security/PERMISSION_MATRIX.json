{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrellisPermissionMatrix",
  "version": "2.0.0",
  "description": "Unified ABAC/RBAC Data Matrix for the TRELLIS Policy Engine (can(subject, action, resource, context)). Operates on strict Default-Deny.",
  "security_model": {
    "default_policy": "DENY",
    "fallback_decision": {
      "allowed": false,
      "scope": "NONE",
      "approval_required": false,
      "audit": true,
      "reason": "Default-deny policy enforced: no explicit grant exists for this tuple."
    }
  },
  "active_roles": [
    "ADMIN",
    "MENTOR",
    "LEARNER"
  ],
  "future_roles_modeled": [],
  "actions": [
    "create",
    "read",
    "update",
    "delete",
    "approve",
    "export",
    "impersonate",
    "override",
    "publish",
    "grade",
    "review",
    "assign",
    "enrol",
    "download",
    "share"
  ],
  "resources": [
    "users",
    "roles_grants",
    "consents",
    "skills",
    "pathways",
    "enrolments",
    "assessments",
    "items",
    "attempts",
    "responses",
    "growth_ring",
    "evidence_ledger",
    "sessions",
    "greenhouse_ideas",
    "grove_spaces",
    "kb_articles",
    "ai_runs",
    "audit_log",
    "access_receipts",
    "credentials"
  ],
  "scopes": [
    "OWN",
    "TEAM_DIRECT",
    "COHORT",
    "DEPARTMENT",
    "ORGANIZATION",
    "ANONYMIZED_AGGREGATE",
    "BLIND_GRADING",
    "NONE"
  ],
  "rules": [
    {
      "resource": "users",
      "actions": {
        "read": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION"
          },
          "MENTOR": {
            "allowed": true,
            "scope": "COHORT"
          },
          "LEARNER": {
            "allowed": true,
            "scope": "OWN"
          }
        },
        "update": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true
          },
          "LEARNER": {
            "allowed": true,
            "scope": "OWN",
            "fields": [
              "profile_preferences",
              "dyslexia_font_enabled",
              "theme"
            ]
          }
        },
        "delete": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "approval_required": true,
            "audit": true
          },
          "LEARNER": {
            "allowed": true,
            "scope": "OWN",
            "approval_required": true,
            "audit": true,
            "note": "DPDP_RIGHT_TO_ERASURE_CRYPTO_SHRED"
          }
        }
      }
    },
    {
      "resource": "roles_grants",
      "actions": {
        "create": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "approval_required": true,
            "audit": true,
            "condition": "time_bounded_with_expiry"
          }
        },
        "read": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true
          },
          "LEARNER": {
            "allowed": true,
            "scope": "OWN"
          }
        },
        "delete": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "approval_required": true,
            "audit": true
          }
        }
      }
    },
    {
      "resource": "consents",
      "actions": {
        "read": {
          "LEARNER": {
            "allowed": true,
            "scope": "OWN"
          }
        },
        "create": {
          "LEARNER": {
            "allowed": true,
            "scope": "OWN",
            "audit": true
          }
        },
        "update": {
          "LEARNER": {
            "allowed": true,
            "scope": "OWN",
            "audit": true,
            "note": "ONE_CLICK_REVOCATION"
          }
        }
      }
    },
    {
      "resource": "skills",
      "actions": {
        "read": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION"
          },
          "MENTOR": {
            "allowed": true,
            "scope": "ORGANIZATION"
          },
          "LEARNER": {
            "allowed": true,
            "scope": "ORGANIZATION"
          }
        },
        "create": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true
          }
        },
        "update": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true
          }
        },
        "delete": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "approval_required": true,
            "audit": true
          }
        }
      }
    },
    {
      "resource": "pathways",
      "actions": {
        "read": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION"
          },
          "MENTOR": {
            "allowed": true,
            "scope": "ORGANIZATION"
          },
          "LEARNER": {
            "allowed": true,
            "scope": "ORGANIZATION"
          }
        },
        "create": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true
          }
        },
        "publish": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true,
            "condition": "author != subject"
          },
          "MENTOR": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "approval_required": false,
            "audit": true,
            "condition": "author != subject"
          }
        },
        "assign": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true
          },
          "MENTOR": {
            "allowed": true,
            "scope": "TEAM_DIRECT",
            "audit": true,
            "condition": "learning_load_guard_passed"
          }
        }
      }
    },
    {
      "resource": "enrolments",
      "actions": {
        "read": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION"
          },
          "MENTOR": {
            "allowed": true,
            "scope": "COHORT"
          },
          "LEARNER": {
            "allowed": true,
            "scope": "OWN"
          }
        },
        "enrol": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true
          },
          "MENTOR": {
            "allowed": true,
            "scope": "TEAM_DIRECT",
            "audit": true
          },
          "LEARNER": {
            "allowed": true,
            "scope": "OWN",
            "audit": true
          }
        }
      }
    },
    {
      "resource": "assessments",
      "actions": {
        "read": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION"
          },
          "MENTOR": {
            "allowed": true,
            "scope": "COHORT"
          },
          "LEARNER": {
            "allowed": true,
            "scope": "COHORT",
            "condition": "is_active == true"
          }
        },
        "create": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true
          }
        },
        "publish": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "approval_required": true,
            "audit": true,
            "condition": "author != subject"
          }
        }
      }
    },
    {
      "resource": "items",
      "actions": {
        "read": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION"
          }
        },
        "create": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true
          }
        },
        "review": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true
          }
        }
      }
    },
    {
      "resource": "attempts",
      "actions": {
        "create": {
          "LEARNER": {
            "allowed": true,
            "scope": "OWN",
            "audit": true
          }
        },
        "read": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION"
          },
          "MENTOR": {
            "allowed": true,
            "scope": "COHORT",
            "condition": "candidate_identity_redacted"
          },
          "LEARNER": {
            "allowed": true,
            "scope": "OWN"
          }
        },
        "update": {
          "LEARNER": {
            "allowed": true,
            "scope": "OWN",
            "condition": "attempt_in_progress == true"
          }
        }
      }
    },
    {
      "resource": "responses",
      "actions": {
        "grade": {
          "MENTOR": {
            "allowed": true,
            "scope": "BLIND_GRADING",
            "audit": true,
            "condition": "candidate_identity_redacted"
          }
        },
        "override": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "approval_required": true,
            "audit": true,
            "condition": "mandatory_justification_logged"
          }
        }
      }
    },
    {
      "resource": "growth_ring",
      "actions": {
        "read": {
          "ADMIN": {
            "allowed": true,
            "scope": "ANONYMIZED_AGGREGATE",
            "audit": true
          },
          "MENTOR": {
            "allowed": true,
            "scope": "COHORT",
            "audit": true,
            "access_receipt": true
          },
          "LEARNER": {
            "allowed": true,
            "scope": "OWN"
          }
        },
        "download": {
          "LEARNER": {
            "allowed": true,
            "scope": "OWN",
            "audit": true,
            "note": "GROWTH_RING_PDF_DOWNLOAD"
          }
        },
        "share": {
          "LEARNER": {
            "allowed": true,
            "scope": "OWN",
            "audit": true,
            "note": "CONSENT_PASSPORT_SHARING"
          }
        }
      }
    },
    {
      "resource": "evidence_ledger",
      "actions": {
        "read": {
          "MENTOR": {
            "allowed": true,
            "scope": "COHORT",
            "audit": true,
            "access_receipt": true
          },
          "LEARNER": {
            "allowed": true,
            "scope": "OWN"
          }
        },
        "create": {
          "MENTOR": {
            "allowed": true,
            "scope": "COHORT",
            "audit": true
          },
          "LEARNER": {
            "allowed": true,
            "scope": "OWN",
            "approval_required": true,
            "audit": true,
            "condition": "type == 'self_reflection'"
          }
        },
        "update": {
          "ADMIN": {
            "allowed": false,
            "scope": "NONE",
            "note": "IMMUTABLE_INVARIANT"
          },
          "LEARNER": {
            "allowed": false,
            "scope": "NONE",
            "note": "IMMUTABLE_INVARIANT"
          }
        },
        "delete": {
          "ADMIN": {
            "allowed": false,
            "scope": "NONE",
            "note": "IMMUTABLE_INVARIANT"
          },
          "LEARNER": {
            "allowed": false,
            "scope": "NONE",
            "note": "IMMUTABLE_INVARIANT"
          }
        }
      }
    },
    {
      "resource": "sessions",
      "actions": {
        "read": {
          "MENTOR": {
            "allowed": true,
            "scope": "COHORT"
          },
          "LEARNER": {
            "allowed": true,
            "scope": "COHORT"
          }
        },
        "create": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true
          },
          "MENTOR": {
            "allowed": true,
            "scope": "COHORT",
            "audit": true
          }
        }
      }
    },
    {
      "resource": "greenhouse_ideas",
      "actions": {
        "create": {
          "MENTOR": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true
          },
          "LEARNER": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true
          }
        },
        "read": {
          "MENTOR": {
            "allowed": true,
            "scope": "ORGANIZATION"
          },
          "LEARNER": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "condition": "confidentiality_match == true"
          }
        },
        "approve": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true,
            "condition": "author != subject"
          },
          "MENTOR": {
            "allowed": true,
            "scope": "COHORT",
            "audit": true,
            "condition": "author != subject"
          }
        }
      }
    },
    {
      "resource": "grove_spaces",
      "actions": {
        "read": {
          "MENTOR": {
            "allowed": true,
            "scope": "COHORT"
          },
          "LEARNER": {
            "allowed": true,
            "scope": "COHORT"
          }
        },
        "create": {
          "MENTOR": {
            "allowed": true,
            "scope": "COHORT"
          },
          "LEARNER": {
            "allowed": true,
            "scope": "COHORT",
            "note": "DOUBT_THREAD_CREATION"
          }
        }
      }
    },
    {
      "resource": "kb_articles",
      "actions": {
        "read": {
          "MENTOR": {
            "allowed": true,
            "scope": "ORGANIZATION"
          },
          "LEARNER": {
            "allowed": true,
            "scope": "ORGANIZATION"
          }
        },
        "create": {
          "MENTOR": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true
          }
        },
        "publish": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true,
            "condition": "author != subject"
          },
          "MENTOR": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true,
            "condition": "author != subject"
          }
        }
      }
    },
    {
      "resource": "ai_runs",
      "actions": {
        "create": {
          "LEARNER": {
            "allowed": true,
            "scope": "OWN",
            "audit": true,
            "note": "GARDENER_QUERY"
          }
        },
        "read": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true
          }
        }
      }
    },
    {
      "resource": "audit_log",
      "actions": {
        "read": {
          "ADMIN": {
            "allowed": true,
            "scope": "ORGANIZATION",
            "audit": true
          }
        },
        "update": {
          "ADMIN": {
            "allowed": false,
            "scope": "NONE",
            "note": "IMMUTABLE_INVARIANT"
          }
        },
        "delete": {
          "ADMIN": {
            "allowed": false,
            "scope": "NONE",
            "note": "IMMUTABLE_INVARIANT"
          }
        }
      }
    },
    {
      "resource": "access_receipts",
      "actions": {
        "read": {
          "LEARNER": {
            "allowed": true,
            "scope": "OWN",
            "note": "CONSENT_PASSPORT_VIEW"
          }
        }
      }
    },
    {
      "resource": "credentials",
      "actions": {
        "read": {
          "LEARNER": {
            "allowed": true,
            "scope": "OWN"
          }
        },
        "export": {
          "LEARNER": {
            "allowed": true,
            "scope": "OWN",
            "audit": true,
            "note": "SKILLS_PASSPORT_VC_EXPORT"
          }
        },
        "download": {
          "LEARNER": {
            "allowed": true,
            "scope": "OWN",
            "audit": true
          }
        }
      }
    }
  ]
}