# TRELLIS Environment Configuration Template
TRELLIS_ENV=dev # dev | demo | prod
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL 16 default / Neon Serverless Postgres / MySQL)
# Option 1: Local Docker PostgreSQL (default)
DATABASE_URL=postgresql+asyncpg://trellis_user:specify_strong_password@localhost:5432/trellis
DATABASE_MIGRATION_URL=postgresql+psycopg2://trellis_user:specify_strong_password@localhost:5432/trellis

# Option 2: Neon Serverless PostgreSQL
# DATABASE_URL=postgresql+asyncpg://<neon_user>:<neon_password>@<neon_endpoint>.neon.tech/neondb?sslmode=require
# DATABASE_MIGRATION_URL=postgresql+psycopg2://<neon_user>:<neon_password>@<neon_endpoint>.neon.tech/neondb?sslmode=require

DB_HOST=postgres
DB_PORT=5432
DB_NAME=trellis
DB_USER=trellis_user
DB_PASSWORD=specify_strong_db_password_here
DB_ROOT_PASSWORD=specify_strong_root_password_here

# Redis (Cache, Celery Message Broker, Concurrency Semaphore)
REDIS_URL=redis://:specify_strong_redis_password_here@localhost:6379/0
REDIS_PASSWORD=specify_strong_redis_password_here

# Security & Asymmetric JWT (RS256 key pair)
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt_public.pem
JWT_KEY_ROTATION_DIR=secrets/rotated_keys
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Field-level Encryption (AES-256 Fernet for sensitive data at rest)
# Generate with: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
FIELD_ENCRYPTION_KEY=specify_32_byte_base64_fernet_key_here
LEDGER_SALT_KEY=specify_32_byte_ledger_salt_key_here
SECRET_KEY=specify_32_byte_secret_key_salt_here

# Argon2id Parameters
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# CodeRunner Isolated Execution Engine
CODE_RUNNER=local # local (dev only) | docker | judge0
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=
CODERUNNER_SANDBOX_TIMEOUT_SECONDS=5
CODERUNNER_MAX_MEMORY_MB=256

# AI Question Generation & LLM Assistant (Anthropic Claude & Self-hosted Ollama)
AI_MODEL_ID=claude-3-5-sonnet-20241022
AI_API_KEY=
AI_BASE_URL=https://api.anthropic.com
AI_REQUEST_TIMEOUT_SECONDS=45
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b

# Allowed Meeting Link Hostnames
MEETING_ALLOWLIST_HOSTS=["teams.microsoft.com","meet.google.com","zoom.us","csm.tech"]

# CORS Origins
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","http://localhost:3000","http://127.0.0.1:3000"]
