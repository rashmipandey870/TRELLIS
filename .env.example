# TRELLIS Environment Configuration Template
TRELLIS_ENV=development # development | demo | production
ORG_ID=csm-tech

# Database Configuration (MySQL 8+ InnoDB utf8mb4)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trellis
DB_USER=trellis_user
DB_PASSWORD=trellis_secure_pass
DB_ROOT_PASSWORD=trellis_root_pass

# Redis (Cache, Celery Broker, PubSub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security & Secrets
SECRET_KEY=replace-with-a-32-byte-hex-string-for-jwt-signing
FIELD_ENCRYPTION_KEY=replace-with-fernet-compatible-base64-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# SSO (Microsoft Entra ID / OIDC)
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TENANT_ID=
OIDC_METADATA_URL=https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration

# AI Governance & NVIDIA NIM
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL_ID=meta/llama-3.1-70b-instruct
USE_NIM_MOCK=true

# Feature Flags
FEATURE_PSYCHOMETRICS=false
FEATURE_WEBCAM_PROCTORING=false
FEATURE_DEMO_DATA=false
FEATURE_MCP_SERVER=false
