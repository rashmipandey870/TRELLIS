# TRELLIS Environment Configuration Template
TRELLIS_ENV=development # development | demo | production
ORG_ID=csm-tech

# Multi-Database Configuration
# Option 1: SQL Server (Production Default for CSM Technology)
# DATABASE_URL=mssql+pyodbc://trellis_user:YourStrongPassword!@localhost:1433/trellis?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Option 2: MySQL 8.4+
DB_HOST=mysql
DB_PORT=3306
DB_NAME=trellis
DB_USER=trellis_user
DB_PASSWORD=specify_strong_db_password_here
DB_ROOT_PASSWORD=specify_strong_root_password_here
# Option 3: SQLite (Local development / in-memory testing)
# DATABASE_URL=sqlite:///./trellis.db

# Redis (Cache, Celery Broker, PubSub)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=specify_strong_redis_password_here
REDIS_URL=redis://:specify_strong_redis_password_here@redis:6379/0

# Security & Secrets (Strict Argon2 + Short-lived JWT)
SECRET_KEY=specify_32_byte_hex_string_for_jwt_signing
FIELD_ENCRYPTION_KEY=specify_fernet_compatible_base64_encryption_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# SSO (Microsoft Entra ID / OIDC Target)
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TENANT_ID=
OIDC_METADATA_URL=https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration

# LLM Providers (Anthropic Claude or Configurable OpenAI / NVIDIA NIM)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL_ID=nvidia/llama-3.1-nemotron-70b-instruct
USE_NIM_MOCK=true

# CodeRunner Isolated Execution Engine
CODERUNNER_SANDBOX_TIMEOUT_SECONDS=5
CODERUNNER_MAX_MEMORY_MB=256
JUDGE0_URL=http://localhost:2358

# Global Governance Thresholds (Step 6 Dedication Criteria)
PRACTICE_ACTIVE_DAYS_THRESHOLD=10
PRACTICE_ACCURACY_THRESHOLD=70
PRACTICE_PROBLEMS_THRESHOLD=15
TALENT_ALERT_COOLDOWN_DAYS=14

# Feature Flags
FEATURE_PSYCHOMETRICS=false
FEATURE_WEBCAM_PROCTORING=false
FEATURE_DEMO_DATA=true
FEATURE_MCP_SERVER=false
